{
  "name": "spam-scanner-monorepo",
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "test": "npm test --workspace=app/server",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "mock-rspamd": "node bin/local/mock-rspamd.mjs",
    "front:start": "npm start --workspace=front"
  },
  "devDependencies": {
    "express": "^5.1.0"
  }
}
