{
  "name": "spam-scanner",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "generate:env-example": "node src/cli/generate-env-example.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "env-cmd -f .env vitest run --config vitest.integration.config.js"
  },
  "dependencies": {
    "email-addresses": "^5.0.0",
    "imapflow": "^1.0.148",
    "mailparser": "^3.9.28",
    "openai": "^7.17.0",
    "pino": "^8.14.1",
    "yargs": "^17.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "env-cmd": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^10.0.0",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  }
}
