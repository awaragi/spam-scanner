# OS
.DS_Store

# Logs
logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage (npm run test:coverage)
coverage
*.lcov
.nyc_output

# Dependency directories
node_modules/

# Optional npm/eslint caches
.npm
.eslintcache

# dotenv environment variable files
.env
.env.*
!.env.example

# Output of 'npm pack'
*.tgz

# Local-only helper scripts
*.local.sh

# Local AI-assistant tool directories - explicit rather than relying on a
# global gitignore, so a fresh clone behaves the same on any machine.
/.idea/
/.junie/
/.windsurf/
.temp/

# App data / rspamd Docker bind-mount target (see SPAM_SCANNER_DATA)
data/

# Rspamd controller password hash - generated per install (see
# bin/local/hash-rspamd-password.sh), must never be a shared committed secret
rspamd/config/worker-controller.inc
