# App settings - should be carried forward unchanged
RSPAMD_URL=http://rspamd.fixture.internal:11334
RSPAMD_PASSWORD=fixture-rspamd-password
AI_ENABLED=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-fixture-ai-key
AI_MODEL=gpt-4o-mini
SCAN_INTERVAL=120

# Mailbox connection (terminal's shape) - should be mapped to MAILBOX_* keys
IMAP_HOST=imap.fixture.example.com
IMAP_PORT=993
IMAP_USER=owner@fixture.example.com
IMAP_PASSWORD=fixture-imap-password
IMAP_TLS=true
IMAP_ALLOW_INSECURE=false
FOLDER_STATE=INBOX.scanner.state

# Per-mailbox behavioral settings - should be dropped silently
FOLDER_INBOX=INBOX
SPAM_CLEAN_THRESHOLD=25
SPAM_LOW_THRESHOLD=55
SCAN_READ=true
